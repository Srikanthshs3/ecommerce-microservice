# =====================================================================================================
#  ONE environment file for the whole platform.   cp .env.example .env   then fill in the REQUIRED block.
#  NEVER commit `.env` (it is in .gitignore). Commit only this example, with every secret left EMPTY.
#
#  Who reads it
#    * api-gateway + every service started from IntelliJ / `mvn spring-boot:run`: via spring.config.import
#      (looks in ./.env and ../.env, so it works whether the working directory is the repo root or a module).
#    * docker-compose: automatically, but only to fill the ${VARS} in docker-compose.yml. The file itself is NOT
#      copied into the containers; docker-compose.yml lists which variables each service receives.
#  Everything NOT listed here (DB / Kafka / Redis / Mongo / mail / Eureka) comes from the config-server repo.
# =====================================================================================================

# ---------------------------------------------------------------------------- REQUIRED
# JWT signing key. user-service SIGNS tokens with it, api-gateway VERIFIES them: it MUST be identical for both.
# >= 32 bytes.   Generate:  openssl rand -base64 32
JWT_SECRET=

# Token issuer. user-service writes it into every token, the gateway rejects tokens with a different one.
JWT_ISSUER=ecommerce-user-service

# AES-256 key that encrypts bank account numbers in MySQL (user-service). base64 of EXACTLY 32 bytes.
#   Generate:  openssl rand -base64 32
# BACK THIS UP. Losing or changing it makes already-stored encrypted columns unreadable.
APP_CRYPTO_KEY=

# Refresh-token cookie `Secure` flag.  false = works on http://localhost (development).  true = production (HTTPS).
COOKIE_SECURE=false

# ---------------------------------------------------------------------------- OPTIONAL hardening
# When set, the gateway HMAC-signs the X-User-* headers and every service rejects headers without a valid
# signature (protects against a caller that reaches a service directly). Same value everywhere, >= 32 chars.
GATEWAY_IDENTITY_SIGNING_SECRET=

# ---------------------------------------------------------------------------- OPTIONAL overrides (local runs only)
# Docker needs NO change here: docker-compose.yml already points the containers at broker:29092 and the
# other service names. These apply when you start a service from IntelliJ against the compose-run infrastructure.
# SPRING_CLOUD_CONFIG_URI=http://localhost:8888
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# SCHEMA_REGISTRY_URL=http://localhost:8081

# ---------------------------------------------------------------------------- category-service
# true  = on first start, load the starter taxonomy (10 departments > 51 categories > 258 brands) if the collection is empty.
# false = never seed (set this once real categories exist, and in production).
# CATEGORY_SEED_ENABLED=true

# ---------------------------------------------------------------------------- payment-service
# REQUIRED while PAYMENT_GATEWAY_DEFAULT=RAZORPAY. Razorpay dashboard > Test Mode > API Keys.
# The secret is shown only once at creation: save it. NEVER send the secret to the frontend (the key id is public).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only if you switch the default gateway to STRIPE:
# STRIPE_SECRET_KEY=

# ---------------------------------------------------------------------------- docker-compose only
# Password used for MySQL root, Postgres and the services' datasources in docker-compose-main.yml.
DB_PASSWORD=

# Hard-coding a dummy admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Admin