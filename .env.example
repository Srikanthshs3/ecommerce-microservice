# =====================================================================================================
#  ONE environment file for the whole platform.   cp .env.example .env   then fill in the REQUIRED block.
#  NEVER commit `.env` (it is in .gitignore). Commit only this example, with every secret left EMPTY.
#
#  Who reads it
#    * api-gateway + every service started from IntelliJ / `mvn spring-boot:run`: via spring.config.import
#      (looks in ./.env and ../.env, so it works whether the working directory is the repo root or a module).
#    * docker-compose: automatically, but only to fill the ${VARS} in docker-compose.yml. The file itself is NOT
#      copied into the containers; docker-compose.yml lists which variables each service receives.
#  Everything NOT listed here (DB / Kafka / Redis / Mongo / mail / Eureka) comes from the config-server repo.
# =====================================================================================================

# ---------------------------------------------------------------------------- REQUIRED
# JWT signing key. user-service SIGNS tokens with it, api-gateway VERIFIES them: it MUST be identical for both.
# >= 32 bytes.   Generate:  openssl rand -base64 32
JWT_SECRET=

# Token issuer. user-service writes it into every token, the gateway rejects tokens with a different one.
JWT_ISSUER=ecommerce-user-service

# AES-256 key that encrypts bank account numbers in MySQL (user-service). base64 of EXACTLY 32 bytes.
#   Generate:  openssl rand -base64 32
# BACK THIS UP. Losing or changing it makes already-stored encrypted columns unreadable.
APP_CRYPTO_KEY=

# Refresh-token cookie `Secure` flag.  false = works on http://localhost (development).  true = production (HTTPS).
COOKIE_SECURE=false

# ---------------------------------------------------------------------------- Failed-login protection
# 3 wrong passwords -> the next login needs the Google "I'm not a robot" check; 6 wrong passwords -> the account is
# blocked and only an admin can unblock it (the blocked user cannot use "Forgot password" either).
# Secret key of your reCAPTCHA v2 ("I'm not a robot" checkbox) site: https://www.google.com/recaptcha/admin
# Leave empty to switch the CAPTCHA step off (the block after 6 failures still works).
# For local testing Google publishes test keys that always pass (the widget shows a "testing" banner):
#   secret  6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe   (site key for ecom-frontend/.env: 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI)
RECAPTCHA_SECRET=
# Optional tuning (defaults shown): SECURITY_LOGIN_CAPTCHA_AFTER=3  SECURITY_LOGIN_MAX_FAILURES=6  SECURITY_LOGIN_WINDOW_HOURS=24

# ---------------------------------------------------------------------------- First admin account (optional)
# On startup user-service creates this ADMIN if it does not exist yet (it never overwrites a password).
# Leave both empty to create no admin. Use your own values in your local .env; never commit real ones.
# Password: 8-64 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=Admin

# ---------------------------------------------------------------------------- payment-service (Razorpay)
# Razorpay dashboard > Test Mode > API Keys. Key id looks like rzp_test_xxxxxxxxxxxxxx.
# The secret is shown only once when generated: save it here. NEVER send the secret to the frontend.
# Without these the app still starts; Razorpay payments fail with "Razorpay is not configured".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------------------- password-reset email link
# Address of the web app. The reset email links to <this>/reset-password?token=...  Default: http://localhost:5173
# APP_FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------- OPTIONAL hardening
# When set, the gateway HMAC-signs the X-User-* headers and every service rejects headers without a valid
# signature (protects against a caller that reaches a service directly). Same value everywhere, >= 32 chars.
GATEWAY_IDENTITY_SIGNING_SECRET=

# ---------------------------------------------------------------------------- docker-compose only
# Password used for MySQL root, Postgres and the services' datasources in docker-compose.yml.
DB_PASSWORD=

# ---------------------------------------------------------------------------- OPTIONAL overrides (local runs only)
# Docker needs NO change here: docker-compose.yml already points the containers at broker:29092 and the
# other service names. These apply when you start a service from IntelliJ against the compose-run infrastructure.
# SPRING_CLOUD_CONFIG_URI=http://localhost:8888
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# SCHEMA_REGISTRY_URL=http://localhost:8081

# ---------------------------------------------------------------------------- category-service
# true  = on first start, load the starter taxonomy (10 departments > 51 categories > 258 brands) if empty.
# false = never seed (set this once real categories exist, and in production).
# CATEGORY_SEED_ENABLED=true

# ---- Stage 1 payments (TEST keys only; leave empty to hide a gateway) ----
# Razorpay: dashboard -> Account & Settings -> API keys (Test mode)
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx   RAZORPAY_KEY_SECRET=...
# Stripe: dashboard -> Developers -> API keys (Test mode). Both keys are needed.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional webhooks (safety net when the customer closes the tab right after paying).
# Stripe locally:  stripe listen --forward-to localhost:2323/api/v1/payment/webhooks/stripe   (prints the whsec_ secret)
RAZORPAY_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=

# --- Stage 3: delivery ---
# Long random string used to derive the customer delivery code (OTP). Change it.
SHIPPING_OTP_SECRET=
SHIPPING_AGENT_MAX_ACTIVE=10
SHIPPING_DELIVERY_MAX_ATTEMPTS=2
